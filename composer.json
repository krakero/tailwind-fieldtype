{
    "name": "krakero/tailwind-fieldtype",
    "description": "A Tailwind CSS color picker fieldtype for Statamic",
    "license": "MIT",
    "keywords": ["statamic", "tailwind", "fieldtype", "color-picker"],
    "support": {
        "issues": "https://github.com/krakero/tailwind-fieldtype/issues",
        "source": "https://github.com/krakero/tailwind-fieldtype"
    },
    "autoload": {
        "psr-4": {
            "Krakero\\TailwindFieldtype\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Tailwind Fieldtype",
            "description": "Tailwind Fieldtype addon"
        },
        "laravel": {
            "providers": [
                "Krakero\\TailwindFieldtype\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "orchestra/testbench": "^10.8 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Krakero\\TailwindFieldtype\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
